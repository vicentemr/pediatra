---
import { site, type Lang } from '../data/site';
import { t } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---

<div class="faq">
  <h2>{s.faq.title}</h2>
  <div class="faq__list">
    {site.faq.map((f) => (
      <details>
        <summary>{f.q[lang]}</summary>
        <p>{f.a[lang]}</p>
      </details>
    ))}
  </div>
</div>

<style>
  .faq { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--space-4); align-items: start; }
  .faq__list { border-top: 2px solid var(--ink); }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer;
    display: flex; justify-content: space-between; gap: var(--space-2); align-items: center;
    padding: 1.1rem 0; font: 700 var(--step-1)/1.25 var(--font-display); letter-spacing: -0.01em;
  }
  summary::-webkit-details-marker { display: none; }
  summary::after {
    content: ''; flex: none; width: 0.75rem; height: 0.75rem;
    border-right: 2.5px solid var(--tomato); border-bottom: 2.5px solid var(--tomato);
    transform: rotate(45deg) translateY(-3px); transition: transform 0.3s var(--ease-out);
  }
  details[open] summary::after { transform: rotate(225deg) translateY(-3px); }
  details p { padding: 0 0 1.25rem; color: var(--ink-soft); max-width: 60ch; }
  @media (max-width: 860px) { .faq { grid-template-columns: 1fr; gap: var(--space-3); } }
</style>
