---
import type { Lang } from '../data/site';

// Bandera de cada idioma: España para español, Reino Unido para inglés (la web usa en_GB).
interface Props { code: Lang }
const { code } = Astro.props;
---

<svg class="flag" viewBox={code === 'es' ? '0 0 3 2' : '0 0 60 40'} preserveAspectRatio="xMidYMid slice" aria-hidden="true">
  {code === 'es' ? (
    <>
      <rect width="3" height="2" fill="#c60b1e" />
      <rect y="0.5" width="3" height="1" fill="#ffc400" />
    </>
  ) : (
    <g transform="translate(0 5)">
      <clipPath id="flag-uk-clip"><path d="M30,15 h30 v15 z v15 h-30 z h-30 v-15 z v-15 h30 z" /></clipPath>
      <rect y="-5" width="60" height="40" fill="#012169" />
      <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6" />
      <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#flag-uk-clip)" stroke="#c8102e" stroke-width="4" />
      <path d="M30,-5 v40 M0,15 h60" stroke="#fff" stroke-width="10" />
      <path d="M30,-5 v40 M0,15 h60" stroke="#c8102e" stroke-width="6" />
    </g>
  )}
</svg>

<style>
  .flag {
    width: 1.5rem; height: 1rem; flex: none;
    border-radius: 2px;
    box-shadow: 0 0 0 1px rgb(16 38 29 / 0.15);
  }
</style>
