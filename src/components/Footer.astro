---
import { site, type Lang } from '../data/site';
import { routes, t, type RouteKey } from '../i18n/ui';

interface Props { lang: Lang; route: RouteKey }
const { lang } = Astro.props;
const s = t(lang);
const c = site.contact;
---

<footer class="footer on-bottle" id="contacto">
  <div class="wrap footer__grid">
    <div class="footer__intro">
      <h2 class="footer__title">{s.contact.title}</h2>
      <p class="footer__hours">{c.hours[lang]}</p>
    </div>
    <dl class="footer__list">
      <div><dt>{lang === 'es' ? 'Dirección' : 'Address'}</dt><dd>{c.address}</dd></div>
      <div><dt>{lang === 'es' ? 'Teléfono' : 'Phone'}</dt><dd class="num"><a href={c.phoneHref}>{c.phone}</a></dd></div>
      <div><dt>Email</dt><dd><a href={`mailto:${c.email}`}>{c.email}</a></dd></div>
    </dl>
    <div class="footer__actions">
      <a class="btn" href={c.whatsappHref} rel="noopener">{s.contact.whatsapp}</a>
      <a class="btn btn--quiet" href={c.mapsHref} rel="noopener">{s.contact.map}</a>
    </div>
  </div>
  <div class="wrap footer__base">
    <p>© {new Date().getFullYear()} {site.doctor.name}. {s.footer.rights}</p>
    <a href={routes.legal[lang]}>{s.footer.legal}</a>
  </div>
</footer>

<style>
  .footer { padding-block: var(--space-5) var(--space-3); }
  .footer__grid {
    display: grid; gap: var(--space-4);
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1.2fr) auto;
    align-items: start;
  }
  .footer__title { font-size: var(--step-3); }
  .footer__hours { margin-top: var(--space-2); color: var(--on-bottle-soft); max-width: 28ch; }
  .footer__list { margin: 0; display: grid; gap: var(--space-2); }
  .footer__list dt { font-size: var(--step--1); color: var(--on-bottle-soft); }
  .footer__list dd { margin: 0; font-weight: 600; }
  .footer__actions { display: grid; gap: 0.75rem; }
  .footer__base {
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-2);
    margin-top: var(--space-5); padding-top: var(--space-3);
    border-top: 1px solid rgb(234 243 230 / 0.2);
    font-size: var(--step--1); color: var(--on-bottle-soft);
  }
  @media (max-width: 820px) {
    .footer__grid { grid-template-columns: 1fr; }
    .footer__actions { grid-auto-flow: column; justify-content: start; }
  }
  @media (max-width: 420px) {
    .footer__actions { grid-auto-flow: row; }
  }
</style>
