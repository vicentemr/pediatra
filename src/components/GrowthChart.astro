---
import { site, money, type Lang } from '../data/site';
import { routes, t } from '../i18n/ui';

interface Props { lang: Lang; class?: string }
const { lang, class: className } = Astro.props;
const s = t(lang);

// Área del gráfico (unidades del viewBox)
const W = 640, H = 440;
const X0 = 52, X1 = 596, Y0 = 20, Y1 = 396;
const MAX_M = 36, MIN_KG = 2, MAX_KG = 18;
const x = (m: number) => X0 + (m / MAX_M) * (X1 - X0);
const y = (kg: number) => Y1 - ((kg - MIN_KG) / (MAX_KG - MIN_KG)) * (Y1 - Y0);

// Curvas ilustrativas de peso para la edad (no son tablas clínicas).
const curves = [
  { id: 'p3', base: 2.5, k: 2.7 },
  { id: 'p15', base: 2.9, k: 3.0 },
  { id: 'p50', base: 3.3, k: 3.25 },
  { id: 'p85', base: 3.7, k: 3.55 },
  { id: 'p97', base: 4.1, k: 3.85 },
];
const kgAt = (c: (typeof curves)[number], m: number) => c.base + c.k * Math.log(1 + m / 2.3);
const pts = (c: (typeof curves)[number]) =>
  Array.from({ length: 73 }, (_, i) => i / 2).map((m) => [x(m), y(kgAt(c, m))] as const);
const toPath = (p: readonly (readonly [number, number])[]) =>
  p.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join(' ');
const band = (lo: (typeof curves)[number], hi: (typeof curves)[number]) =>
  `${toPath(pts(hi))} ${pts(lo).reverse().map(([px, py]) => `L${px.toFixed(1)} ${py.toFixed(1)}`).join(' ')} Z`;

const [p3, p15, p50, p85, p97] = curves;
const monthsTicks = [0, 6, 12, 18, 24, 30, 36];
const kgTicks = [4, 8, 12, 16];

const points = site.courses.map((c, i) => {
  const px = x(c.ageMonths), py = y(kgAt(p50, c.ageMonths));
  // Etiquetas alternadas arriba/abajo para que no se pisen
  const above = i % 2 === 0;
  const w = Math.max(c.name[lang].length * 9.4 + 22, 110);
  // Si la etiqueta no cabe a la derecha del punto, va a la izquierda
  const tx = px + 10 + w > X1 - 4 ? px - 10 - w : px + 10;
  return { ...c, px, py, above, w, tx };
});
---

<figure class:list={['chart', className]}>
  <svg viewBox={`0 0 ${W} ${H}`} aria-labelledby="chart-title">
    <title id="chart-title">{s.hero.chartCaption}</title>
    <g class="chart__grid" aria-hidden="true">
      {monthsTicks.map((m) => <line x1={x(m)} x2={x(m)} y1={Y0} y2={Y1} />)}
      {kgTicks.map((k) => <line x1={X0} x2={X1} y1={y(k)} y2={y(k)} />)}
      <line class="axis" x1={X0} x2={X1} y1={Y1} y2={Y1} />
      <line class="axis" x1={X0} x2={X0} y1={Y0} y2={Y1} />
      {monthsTicks.map((m) => <text class="tick num" x={x(m)} y={Y1 + 26} text-anchor="middle">{m}</text>)}
      {kgTicks.map((k) => <text class="tick num" x={X0 - 12} y={y(k) + 5} text-anchor="end">{k}</text>)}
      <text class="unit" x={X1} y={Y1 - 10} text-anchor="end">{s.hero.months}</text>
      <text class="unit" x={X0 + 10} y={Y0 + 16}>{s.hero.kg}</text>
    </g>

    <g aria-hidden="true">
      <path class="band band--outer" d={band(p3, p97)} />
      <path class="band band--inner" d={band(p15, p85)} />
      {[p3, p15, p85, p97].map((c, i) => (
        <path class="curve" d={toPath(pts(c))} pathLength="1" style={`--d:${0.15 + i * 0.12}s`} />
      ))}
      <path class="curve curve--p50" d={toPath(pts(p50))} pathLength="1" style="--d:0.05s" />
      {curves.map((c) => (
        <text class="plabel num" x={X1 + 6} y={y(kgAt(c, MAX_M)) + 4}>{c.id.toUpperCase()}</text>
      ))}
    </g>

    {points.map((p, i) => (
      <a class="pt" href={`${routes.courses[lang]}#${p.id}`} style={`--d:${1 + i * 0.18}s`}
        aria-label={`${p.name[lang]}, ${p.stage[lang]}, ${money(p.price, lang)}`}>
        <line class="pt__stem" x1={p.px} x2={p.px} y1={p.py} y2={p.above ? p.py - 58 : p.py + 58} />
        <circle class="pt__halo" cx={p.px} cy={p.py} r="15" />
        <circle class="pt__dot" cx={p.px} cy={p.py} r="8" />
        <g transform={`translate(${p.tx} ${p.above ? p.py - 74 : p.py + 46})`}>
          <rect class="pt__tag" x="0" y="0" width={p.w} height="40" rx="6" />
          <text class="pt__name" x="11" y="17">{p.name[lang]}</text>
          <text class="pt__meta num" x="11" y="33">{p.stage[lang]} · {money(p.price, lang)}</text>
        </g>
      </a>
    ))}
  </svg>
  <ol class="chart__legend" role="list">
    {points.map((p) => (
      <li><a href={`${routes.courses[lang]}#${p.id}`}><span class="dot" aria-hidden="true"></span><strong>{p.name[lang]}</strong> <span class="num">{p.stage[lang]} · {money(p.price, lang)}</span></a></li>
    ))}
  </ol>
  <figcaption>{s.hero.chartCaption}</figcaption>
</figure>

<style>
  .chart { margin: 0; }
  .chart svg { width: 100%; height: auto; overflow: visible; }
  .chart figcaption { margin-top: 0.5rem; font-size: var(--step--1); color: var(--ink-soft); max-width: 52ch; }
  .chart__grid line { stroke: var(--grid-strong); stroke-width: 1; }
  .chart__grid .axis { stroke: var(--ink); stroke-width: 1.5; }
  .tick { font: 600 15px var(--font-display); fill: var(--ink-soft); }
  .unit { font: 700 14px var(--font-text); fill: var(--ink-soft); }
  .band--outer { fill: rgb(227 167 47 / 0.16); }
  .band--inner { fill: rgb(227 167 47 / 0.26); }
  .curve { fill: none; stroke: var(--bottle); stroke-width: 1.6; stroke-linecap: round; opacity: 0.7; }
  .curve--p50 { stroke: var(--tomato); stroke-width: 4; opacity: 1; }
  .plabel { font: 700 12px var(--font-display); fill: var(--bottle); }

  .pt { cursor: pointer; }
  .pt__stem { stroke: var(--bottle); stroke-width: 1.5; stroke-dasharray: 3 4; }
  .pt__halo { fill: rgb(227 167 47 / 0.35); transform-box: fill-box; transform-origin: center; transition: transform 0.4s var(--ease-out); }
  .pt__dot { fill: var(--ochre); stroke: var(--bottle-deep); stroke-width: 3; }
  .pt__tag { fill: var(--sheet); stroke: var(--bottle); stroke-width: 1.5; transition: fill 0.25s var(--ease-out); }
  .pt__name { font: 700 15px var(--font-display); fill: var(--ink); }
  .pt__meta { font: 600 12.5px var(--font-display); fill: var(--ink-soft); }
  .pt:hover .pt__tag, .pt:focus-visible .pt__tag { fill: var(--ochre-soft); }
  .pt:hover .pt__halo, .pt:focus-visible .pt__halo { transform: scale(1.45); }
  .pt:focus-visible { outline: none; }
  .pt:focus-visible .pt__tag { stroke: var(--tomato); stroke-width: 3; }

  /* Momento de firma: las curvas se trazan como en la cartilla y los cursos aparecen sobre la P50. */
  @media (prefers-reduced-motion: no-preference) {
    .curve { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.6s var(--ease-out) var(--d) forwards; }
    .band { opacity: 0; animation: fade 1.2s var(--ease-out) 0.5s forwards; }
    .pt { opacity: 0; animation: rise 0.7s var(--ease-out) var(--d) forwards; }
  }
  .chart__legend { display: none; list-style: none; margin: 0.75rem 0 0; padding: 0; gap: 0.4rem; }
  .chart__legend a { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.5rem; min-height: 2.75rem; text-decoration: none; }
  .chart__legend .num { color: var(--ink-soft); font-size: var(--step--1); }
  .chart__legend .dot { width: 0.8rem; height: 0.8rem; border-radius: 50%; background: var(--ochre); box-shadow: 0 0 0 2.5px var(--bottle-deep); flex: none; }
  @media (max-width: 600px) {
    .pt g, .pt__stem { display: none; }
    .chart__legend { display: grid; }
    .tick { font-size: 24px; }
    .unit { font-size: 22px; }
    .plabel { font-size: 18px; }
    .chart svg { padding-right: 1.4rem; }
  }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade { to { opacity: 1; } }
  @keyframes rise { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
</style>
